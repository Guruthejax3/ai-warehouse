# ── ReplayTwin ─ environment variables ────────────────────────────────────────
#
# Copy to .env and fill in the values you need.  The pipeline falls back
# to safe defaults when a variable is unset.

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres URL (primary store for events, feedback, replay data).
DATABASE_URL=postgresql://replaytwin:replaytwin@localhost:5432/damage_dna

# Set to a SQLite path to bypass Postgres entirely (useful for laptop demos).
# REPLAYTWIN_DB_SQLITE=data/backend.db

# ── Claude API (assistant chat) ───────────────────────────────────────────────
# Required only for the RAG assistant.  If unset the assistant returns a
# helpful "API key not configured" message instead of hallucinating.
ANTHROPIC_API_KEY=

# ── Voice coaching ────────────────────────────────────────────────────────────
# Enable text-to-speech for real-time coaching nudges.
VOICE_COACHING_ENABLED=false

# ── Frontend ──────────────────────────────────────────────────────────────────
# API base URL the browser bundle talks to (must be reachable from the client).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Target processing FPS (default 4-6).  Lower = faster, less granular.
# TARGET_FPS=5

# Minimum motion score to trigger a person/object search (0-1).
# MIN_MOTION_SCORE=0.08

# Sampling step: process every Nth source frame (1 = every frame).
# SAMPLING_STEP=5
